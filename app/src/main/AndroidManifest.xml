<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ticmouseproto"
    android:versionCode="10"
    android:versionName="0.5.1-prototype">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- 必須：手組みビルドではこの uses-sdk が無いと targetSdk 未指定になり、
         時計側でインストール自体が弾かれる（0.4〜0.4.3 で実際に発生した不具合）。
         Gradle 側は build.gradle の defaultConfig が担うので、そちらの manifest には不要。 -->
    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="33" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="TicMouse Proto"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
